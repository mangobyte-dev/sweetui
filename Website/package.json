{
  "name": "Website",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:workers": "mkdir -p public/images && cp -R ../docs/images/. public/images/ && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "next build && wrangler deploy",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "4.23.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "sharp": ">=0.35.0",
    "postcss": ">=8.5.26",
    "shadcn": {
      "zod": ">=4.6.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": ">=11.0.1"
    },
    "@ts-morph/common": {
      "minimatch": ">=11.0.1"
    }
  }
}
